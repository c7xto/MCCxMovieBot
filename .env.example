# Telegram credentials (required)
API_ID=
API_HASH=
BOT_TOKEN=
SESSION_WORKDIR=runtime

# Deploy a reviewed immutable image tag or, preferably, a registry digest.
BOT_IMAGE=mccxmoviebot:local

# Comma-separated Telegram user IDs
ADMIN_ID=

# MongoDB (primary required; additional clusters optional)
DATABASE_URI=
# Recommended: a separate MongoDB cluster for settings, users, registry,
# verification cache and durable job checkpoints. Legacy data is copied
# automatically and retained when this is added.
OPERATIONS_DATABASE_URI=
DATABASE_URI_2=
DATABASE_URI_3=
DATABASE_URI_4=
DATABASE_URI_5=
# Optional custom CA bundle for certificate-validated MongoDB TLS.
MONGODB_TLS_CA_FILE=
# Development escape hatch only; never enable against production data.
ALLOW_INSECURE_MONGODB_FOR_DEVELOPMENT=false

# Optional: 16+ character key for the explicit encrypted secret-config export.
CONFIG_EXPORT_PASSPHRASE=

# Initial channel configuration
LOG_CHANNEL_ID=
DATABASE_CHANNEL_ID=
UPDATE_CHANNEL=
UPDATE_CHANNEL_LINK=
MAIN_GROUP_LINK=

# Optional one-time rename and branded-cache upload for new source files.
# The branding channel must be private, separate from source channels, and
# the bot must be an administrator there.
FILE_BRANDING_ENABLED=false
FILE_BRANDING_CHANNEL_ID=
FILE_BRANDING_TEXT=@your_bot_username

# Optional TMDB API Read Access Token (Bearer) for upload announcements
TMDB_BEARER_TOKEN=
