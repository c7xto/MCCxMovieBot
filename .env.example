# Telegram credentials (required)
API_ID=
API_HASH=
BOT_TOKEN=
SESSION_WORKDIR=runtime
# Use all-in-one on a single-process panel. Docker Compose overrides this
# with dedicated scalable roles.
SERVICE_ROLE=all-in-one

# Optional in all-in-one mode. Required for every multi-process worker role.
# Docker Compose supplies redis://redis:6379/0 automatically.
REDIS_URL=
REDIS_PREFIX=mccxbot
REDIS_MAX_CONNECTIONS=100

# Deploy a reviewed immutable image tag or, preferably, a registry digest.
BOT_IMAGE=mccxmoviebot:local

# Comma-separated Telegram user IDs
ADMIN_ID=

# MongoDB (primary required; additional clusters optional)
DATABASE_URI=
# Required: a separate MongoDB cluster for settings, users, registry,
# verification cache and durable job checkpoints. Legacy data is copied
# automatically and retained during migration.
OPERATIONS_DATABASE_URI=
DATABASE_URI_2=
DATABASE_URI_3=
DATABASE_URI_4=
DATABASE_URI_5=
# Optional custom CA bundle for certificate-validated MongoDB TLS.
MONGODB_TLS_CA_FILE=
# Development escape hatch only; never enable against production data.
ALLOW_INSECURE_MONGODB_FOR_DEVELOPMENT=false

# Optional: 16+ character key for the explicit encrypted secret-config export.
CONFIG_EXPORT_PASSPHRASE=

# Initial channel configuration. The Control Center can update these later.
LOG_CHANNEL_ID=
# Optional separate destination for in-bot movie request tickets.
REQUEST_CHANNEL_ID=
# Source fallback read from the host environment (shown read-only in the Control Center).
DATABASE_CHANNEL_ID=
# One New Releases channel: numeric ID plus its public/private join link.
UPDATE_CHANNEL=
UPDATE_CHANNEL_LINK=
# External group opened by the Request Group button.
MAIN_GROUP_LINK=

# Optional TMDB API Read Access Token (Bearer) for upload announcements
TMDB_BEARER_TOKEN=
